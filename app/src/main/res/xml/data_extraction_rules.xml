<?xml version="1.0" encoding="utf-8"?>
<!-- The login is bound to a key in this device's keystore: a restored copy could not decrypt it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
